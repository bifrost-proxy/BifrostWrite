{
    "name": "bifrostwrite-desktop",
    "private": true,
    "version": "1.2.5",
    "homepage": "https://github.com/bifrost-proxy/BifrostWrite",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "preinstall": "node scripts/require-npm.mjs",
        "dev": "tauri dev --config src-tauri/tauri.conf.json",
        "renderer:dev": "vite",
        "renderer:build": "tsc -b && vite build",
        "build": "npm run tauri:build",
        "lint": "eslint .",
        "test": "vitest run",
        "test:v8-artifacts": "vitest run scripts/codex-v8-artifacts.test.mjs",
        "test:watch": "vitest",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "test:split-grid-baseline": "vitest run src/app/store/workspaceLayoutTree.test.ts src/app/store/workspaceLayoutNavigation.test.ts src/app/store/editorStore.test.ts src/app/store/editorSession.test.ts src/app/store/layoutStore.test.ts src/features/editor/MultiPaneWorkspace.test.tsx src/features/editor/EditorPaneBar.test.tsx src/features/editor/workspaceTabDropPreview.test.ts src/features/editor/UnifiedBar.test.tsx src/features/vault/FileTree.test.tsx src/features/ai/components/reviewMultiSessionIntegration.test.tsx src/features/ai/components/AIReviewView.test.tsx",
        "preview": "vite preview",
        "tauri:sidecar:build": "cargo build -p neverwrite-native-backend",
        "tauri:sidecar:build:release": "cargo build -p neverwrite-native-backend --release",
        "tauri:sidecar:stage": "node scripts/stage-tauri-sidecar.mjs",
        "tauri:vault-editor:smoke": "node scripts/smoke-native-vault-editor.mjs",
        "tauri:ai-runtime:smoke": "node scripts/smoke-native-ai-runtime.mjs",
        "tauri:sidecar:smoke:packaged": "node scripts/smoke-packaged-sidecar.mjs",
        "tauri:build": "node scripts/stage-tauri-sidecar.mjs && tauri build --config src-tauri/tauri.conf.json",
        "tauri:build:app": "node scripts/stage-tauri-sidecar.mjs && tauri build --config src-tauri/tauri.conf.json --bundles app",
        "tauri:build:dmg": "node scripts/stage-tauri-sidecar.mjs && tauri build --config src-tauri/tauri.conf.json --bundles dmg"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.8.0",
        "@tauri-apps/plugin-dialog": "^2.4.0",
        "@tauri-apps/plugin-opener": "^2.5.0",
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-cpp": "^6.0.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-java": "^6.0.2",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-rust": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.3",
        "@codemirror/legacy-modes": "^6.5.2",
        "@codemirror/merge": "^6.12.1",
        "@codemirror/search": "^6.7.0",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.6",
        "@excalidraw/excalidraw": "^0.18.1",
        "@iconify-json/catppuccin": "^1.2.17",
        "@lezer/common": "^1.5.2",
        "@lezer/highlight": "^1.2.3",
        "@replit/codemirror-vim": "^6.3.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-search": "^0.16.0",
        "@xterm/addon-serialize": "^0.14.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/xterm": "^6.0.0",
        "dompurify": "^3.4.13",
        "katex": "^0.16.45",
        "mermaid": "^11.16.1",
        "papaparse": "^5.5.3",
        "pdfjs-dist": "^6.2.108",
        "react": "19.2.5",
        "react-datasheet-grid": "^4.11.6",
        "react-dom": "19.2.5",
        "react-force-graph-2d": "^1.29.1",
        "react-force-graph-3d": "^1.29.1",
        "tailwindcss": "^4.2.4",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/vite": "^4.2.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.12.2",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.183.1",
        "@vitejs/plugin-react": "^6.0.2",
        "@tauri-apps/cli": "^2.8.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.0",
        "vite": "^8.0.16",
        "vitest": "^4.1.9",
        "yaml": "^2.8.3"
    },
    "overrides": {
        "@chevrotain/cst-dts-gen": {
            "lodash-es": "4.18.1"
        },
        "@chevrotain/gast": {
            "lodash-es": "4.18.1"
        },
        "@excalidraw/excalidraw": {
            "nanoid": "3.3.17"
        },
        "@excalidraw/mermaid-to-excalidraw": {
            "nanoid": "5.1.16"
        },
        "chevrotain": {
            "lodash-es": "4.18.1"
        },
        "mermaid": {
            "uuid": "14.0.0"
        },
        "lightningcss": "1.33.0",
        "react": "$react",
        "react-dom": "$react-dom",
        "react-resize-detector": "12.3.0"
    }
}
